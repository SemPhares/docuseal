<%# Modifié par iSHEERO le 2026-10-14 (DocuSeal 3.3.0, AGPLv3) : logo iSHEERO en tête des mails
    et lien vers le code source modifié en pied de mail. Source : ENV DOCUSEAL_SOURCE_URL. %>
<!DOCTYPE html>
<html>
  <head>
    <title></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style></style>
  </head>
  <body dir="<%= TextUtils.rtl?(yield) ? 'rtl' : 'auto' %>">
    <% if ENV['APP_URL'].present? %>
      <p>
        <img src="<%= ENV['APP_URL'] %>/brand/isheero-logo.png" alt="iSHEERO" width="240" style="display: block; width: 240px; max-width: 100%; height: auto; border: 0;">
      </p>
    <% end %>
    <%= yield %>
    <%= render partial: 'shared/mailer_attribution' %>
    <% if ENV['DOCUSEAL_SOURCE_URL'].present? %>
      <p><a href="<%= ENV['DOCUSEAL_SOURCE_URL'] %>">Code source</a></p>
    <% end %>
  </body>
</html>
